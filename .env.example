# Run python3 scripts/init_env.py to generate independent local secrets.
# These placeholders are deliberately rejected by the backend.
NEXORA_API_KEY=CHANGE_ME_GENERATE_A_RANDOM_SECRET
POSTGRES_PASSWORD=CHANGE_ME_GENERATE_ANOTHER_RANDOM_SECRET
NEXORA_HTTP_PORT=8100
# Optional, non-secret overrides for infrastructure/compose.ai.yml.
# The provider key lives only in secrets/ai_api_key (mode 600).
# NEXORA_AI_BASE_URL=https://integrate.api.nvidia.com/v1
# NEXORA_AI_MODEL=meta/llama-3.3-70b-instruct
